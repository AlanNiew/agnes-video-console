{
  "name": "agnes-video-console",
  "version": "1.9.0",
  "description": "本地 Web 化的 Agnes AI 视频生成任务控制台：接入 agnes-video-2.5(-flash) / agnes-video-v2.0 异步任务 API，创作工作台（分镜/角色/配音/成片渲染）+ 任务队列看板 + 提交队列 + 后台轮询 + SQLite 持久化",
  "main": "server.js",
  "type": "commonjs",
  "private": false,
  "license": "MIT",
  "author": "AlanNiew",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlanNiew/agnes-video-console.git"
  },
  "bugs": {
    "url": "https://github.com/AlanNiew/agnes-video-console/issues"
  },
  "homepage": "https://github.com/AlanNiew/agnes-video-console#readme",
  "keywords": [
    "agnes-ai",
    "video-generation",
    "text-to-video",
    "image-to-video",
    "keyframes",
    "task-queue",
    "sqlite",
    "express",
    "web-console"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "npm run test:unit && npm run test:mock",
    "test:unit": "jest",
    "test:mock": "node test/mock-e2e.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.6"
  }
}
